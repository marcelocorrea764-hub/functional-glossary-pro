    /* =========================================================================
       15. SECCIÓN 8: APRENDER Y PRÁCTICA (QUIZ DE 5, 10 O 20 PREGUNTAS)
       ========================================================================= */
    function generateQuizQuestions(mode, count) {
      const pool = [];

      // 1. Preguntas de traducción de términos CrossFit
      appState.terms.forEach(t => {
        const distractors = appState.terms
          .filter(x => x.id !== t.id)
          .sort(() => Math.random() - 0.5)
          .slice(0, 3)
          .map(x => x.translationAr);
        pool.push({
          type: 'crossfit',
          badge: 'Terminología CrossFit',
          prompt: `¿Qué significa "${t.term}" en entrenamiento funcional / CrossFit?`,
          subprompt: t.pronunciation ? `Pronunciación aproximada: ${t.pronunciation}` : '',
          correct: t.translationAr,
          options: shuffleArray([t.translationAr, ...distractors]),
          explanation: `${t.term}: ${t.explanation}`
        });
      });

      // 2. Preguntas de traducción de ejercicios EN <-> ES-AR
      appState.exercises.forEach(ex => {
        const otherNames = appState.exercises
          .filter(x => x.id !== ex.id)
          .sort(() => Math.random() - 0.5)
          .slice(0, 3)
          .map(x => x.nameEsAr);
        pool.push({
          type: 'translate',
          badge: 'Traducción de Ejercicio',
          prompt: `¿Cuál es la traducción al español argentino de "${ex.nameEn}"?`,
          subprompt: `Pronunciación: ${ex.pronunciation}`,
          correct: ex.nameEsAr,
          options: shuffleArray([ex.nameEsAr, ...otherNames]),
          explanation: `${ex.nameEn} = ${ex.nameEsAr}. ${ex.simpleMeaning}`
        });

        // 3. Reconocimiento de ejercicio por descripción/músculo
        const otherEn = appState.exercises
          .filter(x => x.id !== ex.id)
          .sort(() => Math.random() - 0.5)
          .slice(0, 3)
          .map(x => x.nameEn);
        pool.push({
          type: 'exercise',
          badge: 'Reconocimiento de Movimiento',
          prompt: `¿A qué ejercicio corresponde esta descripción: "${ex.simpleMeaning}"?`,
          subprompt: `Músculos principales: ${(ex.primaryMuscles || []).join(', ')}`,
          correct: ex.nameEn,
          options: shuffleArray([ex.nameEn, ...otherEn]),
          explanation: `${ex.nameEn} (${ex.nameEsAr}): ${ex.technicalDescription}`
        });
      });

      let filteredPool = pool;
      if (mode === 'translate') filteredPool = pool.filter(q => q.type === 'translate');
      else if (mode === 'exercise') filteredPool = pool.filter(q => q.type === 'exercise');
      else if (mode === 'crossfit') filteredPool = pool.filter(q => q.type === 'crossfit');

      if (!filteredPool.length) filteredPool = pool;
      return shuffleArray(filteredPool).slice(0, Math.min(count, filteredPool.length));
    }

    function shuffleArray(arr) {
      const copy = [...arr];
      for (let i = copy.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [copy[i], copy[j]] = [copy[j], copy[i]];
      }
      return copy;
    }

    function startQuizSession() {
      const mode = appState.quiz.mode || 'mixed';
      const len = Number(appState.quiz.length) || 10;
      const questions = generateQuizQuestions(mode, len);
      appState.quiz.activeSession = {
        questions,
        currentIndex: 0,
        score: 0,
        answers: [],
        finished: false
      };
      saveState();
      renderMainSection();
    }

    function answerQuizOption(selectedOption) {
      const session = appState.quiz.activeSession;
      if (!session || session.finished) return;
      const q = session.questions[session.currentIndex];
      if (!q || session.answers[session.currentIndex]) return;

      const isCorrect = selectedOption === q.correct;
      session.answers[session.currentIndex] = { selected: selectedOption, correct: isCorrect };
      appState.quiz.totalAnswered += 1;

      if (isCorrect) {
        session.score += 1;
        appState.quiz.totalCorrect += 1;
        appState.quiz.streak += 1;
        if (appState.quiz.streak > appState.quiz.bestStreak) {
          appState.quiz.bestStreak = appState.quiz.streak;
        }
      } else {
        appState.quiz.streak = 0;
      }

      saveState();
      renderMainSection();
    }

    function nextQuizQuestion() {
      const session = appState.quiz.activeSession;
      if (!session) return;
      if (session.currentIndex + 1 < session.questions.length) {
        session.currentIndex += 1;
      } else {
        session.finished = true;
      }
      saveState();
      renderMainSection();
    }

