    function showToast(message, type = 'info') {
      const container = document.getElementById('toast-container');
      if (!container) return;
      const el = document.createElement('div');
      const colors = {
        info: 'bg-surfaceElevated border-cyan-400/50 text-cyan-200',
        success: 'bg-surfaceElevated border-lime-400/60 text-lime-200',
        error: 'bg-surfaceElevated border-rose-500/60 text-rose-200'
      };
      el.className = `px-4 py-2.5 rounded-2xl border text-xs font-bold shadow-xl transition-all duration-300 ${colors[type] || colors.info}`;
