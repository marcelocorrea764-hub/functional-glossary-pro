          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div class="p-3.5 rounded-2xl bg-carbon border border-slate-800">
              <h3 class="text-xs font-extrabold uppercase tracking-wider text-lime-300">8. Músculos principales</h3>
              ${listChips(ex.primaryMuscles)}
            </div>
            <div class="p-3.5 rounded-2xl bg-carbon border border-slate-800">
              <h3 class="text-xs font-extrabold uppercase tracking-wider text-cyan-300">9. Músculos secundarios</h3>
              ${listChips(ex.secondaryMuscles)}
            </div>
          </div>

          <!-- 10. Equipamiento necesario -->
          <div class="p-3.5 rounded-2xl bg-carbon border border-slate-800">
            <h3 class="text-xs font-extrabold uppercase tracking-wider text-slate-300">10. Equipamiento necesario</h3>
            ${listChips(ex.equipment)}
          </div>

          <!-- 11. Errores frecuentes -->
          <div class="p-3.5 rounded-2xl bg-carbon border border-slate-800">
            <h3 class="text-xs font-extrabold uppercase tracking-wider text-rose-300 mb-1">11. Errores frecuentes</h3>
            <ul class="list-disc list-inside space-y-1 text-slate-200">
              ${(ex.mistakes || []).map(m => `<li>${escapeHtml(m)}</li>`).join('')}
            </ul>
          </div>

          <!-- 12 y 13. Variantes más fáciles y más difíciles -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div class="p-3.5 rounded-2xl bg-carbon border border-slate-800">
              <h3 class="text-xs font-extrabold uppercase tracking-wider text-emerald-300 mb-1">12. Variantes más fáciles</h3>
              <ul class="list-disc list-inside space-y-1 text-slate-200">
                ${(ex.easier || []).map(e => `<li>${escapeHtml(e)}</li>`).join('')}
              </ul>
            </div>
            <div class="p-3.5 rounded-2xl bg-carbon border border-slate-800">
              <h3 class="text-xs font-extrabold uppercase tracking-wider text-amber-300 mb-1">13. Variantes más difíciles</h3>
              <ul class="list-disc list-inside space-y-1 text-slate-200">
                ${(ex.harder || []).map(h => `<li>${escapeHtml(h)}</li>`).join('')}
              </ul>
            </div>
          </div>

          <!-- 15. Recomendaciones de seguridad -->
          <div class="p-3.5 rounded-2xl bg-amber-500/10 border border-amber-500/30">
            <h3 class="text-xs font-extrabold uppercase tracking-wider text-amber-300 mb-1">15. Recomendaciones de seguridad</h3>
            <p class="text-slate-100 leading-relaxed">${escapeHtml(ex.safetyNotes)}</p>
          </div>

          <!-- Material visual / recurso técnico confiable -->
          <div class="p-3.5 rounded-2xl bg-carbon border border-slate-800 space-y-2">
            <h3 class="text-xs font-extrabold uppercase tracking-wider text-cyan-300">Material visual y demostraciones</h3>
            <p class="text-xs text-slate-400">
              Para evitar enlaces rotos o animaciones esquemáticas imprecisas, accedé a una búsqueda verificada de demostraciones técnicas en YouTube para <strong class="text-slate-200">${escapeHtml(ex.nameEn)}</strong>:
            </p>
            <div class="flex flex-wrap gap-2">
              <a
                href="${youtubeSearchUrl}"
                target="_blank"
                rel="noopener noreferrer"
                class="px-3.5 py-2 rounded-xl bg-cyan-400/15 hover:bg-cyan-400/25 border border-cyan-400/40 text-cyan-200 font-bold text-xs inline-flex items-center gap-1.5"
              >
                <span>▶️ Buscar demostración técnica en YouTube</span>
                <span>↗</span>
              </a>
              <button
                onclick="closeExerciseModal(); appState.compareA = '${ex.id}'; navigateTo('compare');"
                class="px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs"
              >
                ⚖️ Llevar al comparador
              </button>
            </div>
          </div>

          <!-- Asignar a lista de estudio -->
          ${appState.studyLists.length ? `
            <div class="p-3.5 rounded-2xl bg-carbon border border-slate-800 space-y-2">
              <h3 class="text-xs font-extrabold uppercase tracking-wider text-slate-300">Listas de estudio</h3>
              <div class="flex flex-wrap gap-2">
                ${appState.studyLists.map(lst => {
                  const inList = (lst.exerciseIds || []).includes(ex.id);
                  return `
                    <button
                      onclick="toggleExerciseInStudyList('${lst.id}', '${ex.id}')"
                      class="px-3 py-1.5 rounded-xl text-xs font-bold border transition ${
                        inList
                          ? 'bg-lime-400 text-slate-950 border-lime-400'
                          : 'bg-surface text-slate-300 border-slate-700 hover:border-lime-400'
                      }"
                    >
                      ${inList ? '✓ ' : '+ '}${escapeHtml(lst.name)}
                    </button>
                  `;
                }).join('')}
              </div>
            </div>
          ` : ''}

          <!-- Nota personal editable -->
          <div class="p-3.5 rounded-2xl bg-carbon border border-slate-800 space-y-2">
            <label for="modal-ex-note" class="block text-xs font-extrabold uppercase tracking-wider text-amber-300">
              Nota personal de entrenamiento
            </label>
            <textarea
              id="modal-ex-note"
              rows="2"
              placeholder="Escribí tus observaciones técnicas, cargas de referencia o correcciones..."
              class="w-full px-3 py-2 rounded-xl bg-surface border border-slate-700 text-xs text-white focus:outline-none focus:border-lime-400"
            >${escapeHtml(currentNote)}</textarea>
            <div class="flex justify-end">
              <button onclick="saveExerciseNote('${ex.id}')" class="px-4 py-2 rounded-xl bg-lime-400 hover:bg-lime-300 text-slate-950 font-extrabold text-xs">
                Guardar nota
              </button>
            </div>
          </div>
        </div>
      `;

      modal.classList.remove('hidden');
    }

    function closeExerciseModal() {
      document.getElementById('exercise-modal').classList.add('hidden');
    }

    function saveExerciseNote(exId) {
      const ta = document.getElementById('modal-ex-note');
      if (!ta) return;
      const val = ta.value.trim();
      if (val) {
        appState.notes[exId] = val;
        showToast('Nota guardada.', 'success');
      } else {
        delete appState.notes[exId];
        showToast('Nota eliminada.', 'info');
      }
      saveState();
      renderMainSection();
    }

    function toggleExerciseInStudyList(listId, exId) {
      const lst = appState.studyLists.find(l => l.id === listId);
      if (!lst) return;
      lst.exerciseIds = lst.exerciseIds || [];
      if (lst.exerciseIds.includes(exId)) {
        lst.exerciseIds = lst.exerciseIds.filter(id => id !== exId);
        showToast(`Quitado de "${lst.name}".`, 'info');
      } else {
        lst.exerciseIds.push(exId);
        showToast(`Agregado a "${lst.name}".`, 'success');
      }
      saveState();
      openExerciseModal(exId);
      renderMainSection();
    }

    /* =========================================================================
       18. CREAR NUEVO EJERCICIO + RESPALDO JSON + RESTAURACIÓN
       ========================================================================= */
    function openNewExerciseModal() {
      const select = document.getElementById('new-ex-category');
      select.innerHTML = CATEGORIES.map(c => `<option value="${escapeAttr(c)}">${escapeHtml(c)}</option>`).join('');
      document.getElementById('new-exercise-modal').classList.remove('hidden');
    }

    function closeNewExerciseModal() {
      document.getElementById('new-exercise-modal').classList.add('hidden');
    }

    function splitCommaOrLine(raw) {
      return String(raw || '')
        .split(/[\n,]+/)
        .map(s => s.trim())
        .filter(Boolean);
    }

    function handleCreateExercise(e) {
      e.preventDefault();
      const fd = new FormData(e.target);
      const nameEn = String(fd.get('nameEn') || '').trim();
      const nameEsAr = String(fd.get('nameEsAr') || '').trim();
      if (!nameEn || !nameEsAr) return;

      const selectedCat = String(fd.get('categories') || CATEGORIES[0]);
      const stepsRaw = String(fd.get('stepsRaw') || '')
        .split(/\n|(?<=\.)\s+/)
        .map(s => s.trim())
        .filter(Boolean);

      const newEx = {
        id: 'custom-' + Date.now(),
        nameEn,
        nameEsAr,
        pronunciation: String(fd.get('pronunciation') || nameEn).trim(),
        categories: [selectedCat],
        difficulty: String(fd.get('difficulty') || 'Intermedio'),
        simpleMeaning: String(fd.get('simpleMeaning') || '').trim(),
        technicalDescription: String(fd.get('technicalDescription') || '').trim(),
        startingPosition: String(fd.get('startingPosition') || '').trim(),
        steps: stepsRaw.length ? stepsRaw : [String(fd.get('stepsRaw') || '').trim()],
        primaryMuscles: splitCommaOrLine(fd.get('primaryMusclesRaw')),
        secondaryMuscles: splitCommaOrLine(fd.get('secondaryMusclesRaw')),
        equipment: splitCommaOrLine(fd.get('equipmentRaw')),
        mistakes: splitCommaOrLine(fd.get('mistakesRaw')),
        easier: splitCommaOrLine(fd.get('easierRaw')),
        harder: splitCommaOrLine(fd.get('harderRaw')),
        safetyNotes: String(fd.get('safetyNotes') || '').trim()
      };

      appState.exercises.unshift(newEx);
      saveState();
      e.target.reset();
      closeNewExerciseModal();
      showToast(`Ejercicio "${newEx.nameEn}" agregado.`, 'success');
      renderMainSection();
      openExerciseModal(newEx.id);
    }

    function openDataModal() {
      document.getElementById('data-modal').classList.remove('hidden');
    }

    function closeDataModal() {
      document.getElementById('data-modal').classList.add('hidden');
    }

    function exportAllData() {
      try {
        const blob = new Blob([JSON.stringify(appState, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `functional-glossary-pro-backup-${new Date().toISOString().slice(0, 10)}.json`;
        a.click();
        URL.revokeObjectURL(url);
        showToast('Respaldo JSON exportado.', 'success');
      } catch (err) {
        showToast('No se pudo exportar el JSON.', 'error');
      }
    }

    function importAllData(event) {
      const file = event.target.files?.[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = (e) => {
        try {
          const parsed = JSON.parse(String(e.target?.result || '{}'));
          if (!Array.isArray(parsed.exercises) || !Array.isArray(parsed.terms)) {
            showToast('Archivo JSON inválido para Functional Glossary Pro.', 'error');
            return;
          }
          appState = { ...getDefaultState(), ...parsed };
          saveState();
          closeDataModal();
          renderNavigation();
          renderMainSection();
          showToast('Datos importados correctamente.', 'success');
        } catch (err) {
          showToast('Error al leer el archivo JSON.', 'error');
        }
      };
      reader.readAsText(file);
      event.target.value = '';
    }

    function resetQuizStats() {
      appState.quiz = {
        ...getDefaultState().quiz,
        mode: appState.quiz.mode,
        length: appState.quiz.length
      };
      saveState();
      showToast('Estadísticas de práctica reiniciadas.', 'info');
      renderMainSection();
    }

    function restoreFactoryData() {
      localStorage.removeItem(STORAGE_KEY);
      appState = getDefaultState();
      saveState();
      closeDataModal();
      renderNavigation();
      renderMainSection();
      showToast('Datos de fábrica restaurados.', 'success');
    }

    /* =========================================================================
       19. UTILIDADES DE ESCAPE Y CERRAR MODALES CON ESCAPE / BACKDROP
       ========================================================================= */
    function escapeHtml(str = '') {
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function escapeAttr(str = '') {
      return escapeHtml(str);
    }

    document.getElementById('exercise-modal').addEventListener('click', (e) => {
      if (e.target.id === 'exercise-modal') closeExerciseModal();
    });
    document.getElementById('new-exercise-modal').addEventListener('click', (e) => {
      if (e.target.id === 'new-exercise-modal') closeNewExerciseModal();
    });
    document.getElementById('data-modal').addEventListener('click', (e) => {
      if (e.target.id === 'data-modal') closeDataModal();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeExerciseModal();
        closeNewExerciseModal();
        closeDataModal();
      }
    });

    // Inicialización de la aplicación
    renderNavigation();
    renderMainSection();
  </script>
</body>
</html>
