<!DOCTYPE html>
<html lang="es-AR" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>FUNCTIONAL GLOSSARY PRO</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'system-ui', '-apple-system', 'sans-serif'],
          },
          colors: {
            carbon: '#090c10',
            surface: '#11161f',
            surfaceElevated: '#18202c',
            surfaceHover: '#1f2938',
            limeVolt: '#a3e635',
            cyanPulse: '#22d3ee',
            amberAlert: '#f59e0b',
            coralError: '#f43f5e',
          },
        },
      },
    };
  </script>

  <style>
    :root {
      color-scheme: dark;
    }
    body {
      background-color: #090c10;
      color: #f8fafc;
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      -webkit-tap-highlight-color: transparent;
      overflow-x: hidden;
    }
    /* Scrollbars discretas para estética deportiva */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #0d121a;
    }
    ::-webkit-scrollbar-thumb {
      background: #263244;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #3b4c66;
    }
    .glass-nav {
      background: rgba(13, 18, 26, 0.92);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
    }
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
  </style>
</head>
<body class="bg-carbon text-slate-100 min-h-screen flex flex-col selection:bg-lime-400 selection:text-slate-950">

  <!-- Contenedor principal centrado tipo app móvil con soporte escritorio -->
  <div id="app" class="w-full max-w-5xl mx-auto min-h-screen flex flex-col relative pb-24">

    <!-- ENCABEZADO SUPERIOR FIJO -->
    <header class="sticky top-0 z-30 glass-nav border-b border-slate-800/90 px-4 py-3 flex items-center justify-between gap-3">
      <div class="flex items-center gap-2.5 min-w-0 cursor-pointer" onclick="navigateTo('home')">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-lime-400 to-cyan-400 flex items-center justify-center text-slate-950 font-black text-lg shadow-lg shadow-lime-500/15 shrink-0">
          FG
        </div>
        <div class="min-w-0">
          <div class="flex items-center gap-1.5">
            <span class="font-black tracking-tight text-sm sm:text-base text-white truncate">FUNCTIONAL GLOSSARY</span>
            <span class="px-1.5 py-0.5 text-[10px] font-extrabold rounded bg-lime-400/15 text-lime-300 border border-lime-400/30">PRO</span>
          </div>
          <p class="text-[11px] text-slate-400 truncate">CrossFit · Funcional · Preparación Física (AR)</p>
        </div>
      </div>

      <div class="flex items-center gap-2 shrink-0">
        <button
          onclick="openNewExerciseModal()"
          class="px-3 py-2 rounded-xl bg-lime-400 hover:bg-lime-300 active:scale-95 text-slate-950 font-bold text-xs flex items-center gap-1.5 transition shadow-md shadow-lime-400/10"
          title="Agregar nuevo ejercicio"
        >
          <span>+</span>
          <span class="hidden sm:inline">Nuevo Ejercicio</span>
          <span class="sm:hidden">Agregar</span>
        </button>
        <button
          onclick="openDataModal()"
          class="p-2 rounded-xl bg-surfaceElevated hover:bg-surfaceHover border border-slate-700/80 text-slate-300 text-xs transition"
          title="Respaldo, exportar/importar y reset"
          aria-label="Opciones de datos y respaldo"
        >
          ⚙️
        </button>
      </div>
    </header>

    <!-- MENÚ SECUNDARIO DE SECCIONES (para acceso directo a las 9 secciones en cualquier momento) -->
    <nav aria-label="Secciones principales" class="px-4 pt-3 pb-2 border-b border-slate-800/60 bg-carbon/80">
      <div id="top-sections-bar" class="flex items-center gap-2 overflow-x-auto no-scrollbar pb-1">
        <!-- Generado dinámicamente por JS -->
      </div>
    </nav>

    <!-- CONTENIDO PRINCIPAL DINÁMICO -->
    <main id="main-content" class="flex-1 px-4 pt-4">
      <!-- Renderizado por vistas -->
    </main>

    <!-- BARRA DE NAVEGACIÓN INFERIOR ESTILO APP ANDROID -->
    <nav aria-label="Navegación inferior" class="fixed bottom-0 left-0 right-0 z-40 glass-nav border-t border-slate-800">
      <div id="bottom-nav" class="max-w-5xl mx-auto grid grid-cols-5 px-1 py-1.5">
        <!-- Generado dinámicamente por JS -->
      </div>
    </nav>
  </div>

  <!-- MODAL DE FICHA COMPLETA DE EJERCICIO (15 CAMPOS + NOTAS + LISTAS + COMPARADOR) -->
  <div id="exercise-modal" class="fixed inset-0 z-50 hidden bg-black/80 backdrop-blur-sm flex items-end sm:items-center justify-center p-0 sm:p-4">
    <div id="exercise-modal-card" class="w-full max-w-3xl max-h-[92vh] bg-surface border border-slate-700/90 rounded-t-3xl sm:rounded-3xl overflow-hidden flex flex-col shadow-2xl">
      <!-- Contenido inyectado dinámicamente -->
    </div>
  </div>

  <!-- MODAL PARA AGREGAR NUEVO EJERCICIO -->
  <div id="new-exercise-modal" class="fixed inset-0 z-50 hidden bg-black/80 backdrop-blur-sm flex items-end sm:items-center justify-center p-0 sm:p-4">
    <div class="w-full max-w-2xl max-h-[92vh] bg-surface border border-slate-700/90 rounded-t-3xl sm:rounded-3xl overflow-hidden flex flex-col shadow-2xl">
      <div class="px-5 py-4 border-b border-slate-800 flex items-center justify-between bg-surfaceElevated">
        <div>
          <h3 class="text-base font-extrabold text-white">Agregar Nuevo Ejercicio</h3>
          <p class="text-xs text-slate-400">Se guardará en tu biblioteca local persistente</p>
        </div>
        <button onclick="closeNewExerciseModal()" class="w-9 h-9 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold flex items-center justify-center">✕</button>
      </div>
      <form id="new-exercise-form" onsubmit="handleCreateExercise(event)" class="p-5 overflow-y-auto space-y-4 text-sm">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-bold text-slate-300 mb-1">Nombre original en inglés *</label>
            <input type="text" name="nameEn" required placeholder="Ej: Devil Press" class="w-full px-3.5 py-2.5 rounded-xl bg-carbon border border-slate-700 text-white focus:outline-none focus:border-lime-400" />
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-300 mb-1">Traducción al español argentino *</label>
            <input type="text" name="nameEsAr" required placeholder="Ej: Burpee con mancuernas y envión" class="w-full px-3.5 py-2.5 rounded-xl bg-carbon border border-slate-700 text-white focus:outline-none focus:border-lime-400" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <div>
            <label class="block text-xs font-bold text-slate-300 mb-1">Pronunciación aproximada *</label>
            <input type="text" name="pronunciation" required placeholder="Ej: Dévil pres" class="w-full px-3.5 py-2.5 rounded-xl bg-carbon border border-slate-700 text-white focus:outline-none focus:border-lime-400" />
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-300 mb-1">Categoría principal *</label>
            <select id="new-ex-category" name="categories" required class="w-full px-3.5 py-2.5 rounded-xl bg-carbon border border-slate-700 text-white focus:outline-none focus:border-lime-400"></select>
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-300 mb-1">Nivel de dificultad *</label>
            <select name="difficulty" required class="w-full px-3.5 py-2.5 rounded-xl bg-carbon border border-slate-700 text-white focus:outline-none focus:border-lime-400">
              <option value="Principiante">Principiante</option>
              <option value="Intermedio" selected>Intermedio</option>
              <option value="Avanzado">Avanzado</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-300 mb-1">Explicación sencilla de qué significa *</label>
          <textarea name="simpleMeaning" rows="2" required placeholder="Explicación clara y directa del movimiento..." class="w-full px-3.5 py-2 rounded-xl bg-carbon border border-slate-700 text-white focus:outline-none focus:border-lime-400"></textarea>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-300 mb-1">Descripción técnica *</label>
          <textarea name="technicalDescription" rows="2" required placeholder="Mecánica articular, vectores de fuerza y control..." class="w-full px-3.5 py-2 rounded-xl bg-carbon border border-slate-700 text-white focus:outline-none focus:border-lime-400"></textarea>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-bold text-slate-300 mb-1">Posición inicial *</label>
            <textarea name="startingPosition" rows="2" required placeholder="Postura inicial, agarre, base de sustentación..." class="w-full px-3.5 py-2 rounded-xl bg-carbon border border-slate-700 text-white focus:outline-none focus:border-lime-400"></textarea>
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-300 mb-1">Ejecución paso a paso (separar por punto o salto de línea) *</label>
            <textarea name="stepsRaw" rows="2" required placeholder="1. Apoyá mancuernas. 2. Hacés burpee. 3. Swing y bloqueo arriba." class="w-full px-3.5 py-2 rounded-xl bg-carbon border border-slate-700 text-white focus:outline-none focus:border-lime-400"></textarea>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-bold text-slate-300 mb-1">Músculos principales (separados por coma) *</label>
            <input type="text" name="primaryMusclesRaw" required placeholder="Ej: Deltoides, Cuádriceps, Glúteos" class="w-full px-3.5 py-2.5 rounded-xl bg-carbon border border-slate-700 text-white focus:outline-none focus:border-lime-400" />
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-300 mb-1">Músculos secundarios (separados por coma)</label>
            <input type="text" name="secondaryMusclesRaw" placeholder="Ej: Pectorales, Tríceps, Abdomen/Core" class="w-full px-3.5 py-2.5 rounded-xl bg-carbon border border-slate-700 text-white focus:outline-none focus:border-lime-400" />
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-300 mb-1">Equipamiento necesario (separado por coma) *</label>
          <input type="text" name="equipmentRaw" required placeholder="Ej: Mancuernas" class="w-full px-3.5 py-2.5 rounded-xl bg-carbon border border-slate-700 text-white focus:outline-none focus:border-lime-400" />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <div>
            <label class="block text-xs font-bold text-slate-300 mb-1">Errores frecuentes *</label>
            <input type="text" name="mistakesRaw" required placeholder="Redondear zona lumbar, perder ritmo" class="w-full px-3.5 py-2.5 rounded-xl bg-carbon border border-slate-700 text-white focus:outline-none focus:border-lime-400" />
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-300 mb-1">Variantes más fáciles *</label>
            <input type="text" name="easierRaw" required placeholder="Sin salto, menor carga" class="w-full px-3.5 py-2.5 rounded-xl bg-carbon border border-slate-700 text-white focus:outline-none focus:border-lime-400" />
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-300 mb-1">Variantes más difíciles *</label>
            <input type="text" name="harderRaw" required placeholder="Mayor carga RX, ritmo continuo" class="w-full px-3.5 py-2.5 rounded-xl bg-carbon border border-slate-700 text-white focus:outline-none focus:border-lime-400" />
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-300 mb-1">Recomendaciones de seguridad *</label>
          <textarea name="safetyNotes" rows="2" required placeholder="Controlar el core, respirar en esfuerzo y evitar picos de fatiga sin técnica..." class="w-full px-3.5 py-2 rounded-xl bg-carbon border border-slate-700 text-white focus:outline-none focus:border-lime-400"></textarea>
        </div>

        <div class="pt-2 flex items-center justify-end gap-2 border-t border-slate-800">
          <button type="button" onclick="closeNewExerciseModal()" class="px-4 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold text-xs">Cancelar</button>
          <button type="submit" class="px-5 py-2.5 rounded-xl bg-lime-400 hover:bg-lime-300 text-slate-950 font-extrabold text-xs">Guardar en Biblioteca</button>
        </div>
      </form>
    </div>
  </div>

  <!-- MODAL DE GESTIÓN DE DATOS (EXPORTAR / IMPORTAR / RESTAURAR) -->
  <div id="data-modal" class="fixed inset-0 z-50 hidden bg-black/80 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="w-full max-w-lg bg-surface border border-slate-700 rounded-3xl overflow-hidden shadow-2xl">
      <div class="px-5 py-4 border-b border-slate-800 flex items-center justify-between bg-surfaceElevated">
        <h3 class="text-base font-extrabold text-white">Datos, Respaldo y Configuración</h3>
        <button onclick="closeDataModal()" class="w-9 h-9 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold flex items-center justify-center">✕</button>
      </div>
      <div class="p-5 space-y-4 text-sm">
        <p class="text-xs text-slate-300 leading-relaxed">
          Todos tus ejercicios agregados, términos personalizados, favoritos, notas, listas de estudio y progreso de práctica se guardan automáticamente en <code class="text-lime-300">localStorage</code>.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
          <button onclick="exportAllData()" class="px-4 py-3 rounded-xl bg-cyan-400/15 hover:bg-cyan-400/25 border border-cyan-400/40 text-cyan-200 font-bold text-xs text-left">
            ⬇️ Exportar JSON completo
          </button>
          <button onclick="document.getElementById('import-json-input').click()" class="px-4 py-3 rounded-xl bg-lime-400/15 hover:bg-lime-400/25 border border-lime-400/40 text-lime-200 font-bold text-xs text-left">
            ⬆️ Importar JSON
          </button>
          <input id="import-json-input" type="file" accept="application/json" class="hidden" onchange="importAllData(event)" />
        </div>

        <div class="pt-3 border-t border-slate-800 flex flex-wrap items-center justify-between gap-2">
          <button onclick="resetQuizStats()" class="px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs">
            Reiniciar progreso de práctica
          </button>
          <button onclick="restoreFactoryData()" class="px-3.5 py-2 rounded-xl bg-rose-500/15 hover:bg-rose-500/25 border border-rose-500/40 text-rose-300 font-bold text-xs">
            Restaurar datos de fábrica
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- TOAST / MENSAJE FLOTANTE (NO USA ALERT) -->
  <div id="toast-container" class="fixed bottom-20 left-1/2 -translate-x-1/2 z-[60] pointer-events-none flex flex-col items-center gap-2 w-full max-w-md px-4"></div>

  <script>
