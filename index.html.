    function handleAddTerm(e) {
      e.preventDefault();
      const fd = new FormData(e.target);
      const termVal = String(fd.get('term') || '').trim();
      if (!termVal) return;
      const newTerm = {
        id: 'term-' + Date.now(),
        term: termVal.toUpperCase(),
        fullName: termVal,
        pronunciation: String(fd.get('pronunciation') || '').trim(),
        translationAr: String(fd.get('translationAr') || '').trim(),
        explanation: String(fd.get('explanation') || '').trim(),
        example: String(fd.get('example') || '').trim()
      };
      appState.terms.unshift(newTerm);
      saveState();
      showAddTermForm = false;
      showToast(`Término "${newTerm.term}" agregado.`, 'success');
      renderMainSection();
    }

