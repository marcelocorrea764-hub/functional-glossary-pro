    function scoreExerciseMatch(ex, rawQuery) {
      const q = normalizeText(rawQuery);
      if (!q) return 1;

      const tokens = q.split(' ').filter(Boolean);
      const nameEn = normalizeText(ex.nameEn);
      const nameEs = normalizeText(ex.nameEsAr);
      const pron = normalizeText(ex.pronunciation);
      const meaning = normalizeText(ex.simpleMeaning);
      const tech = normalizeText(ex.technicalDescription);
      const cats = normalizeText((ex.categories || []).join(' '));
      const eqs = normalizeText((ex.equipment || []).join(' '));
      const muscles = normalizeText([...(ex.primaryMuscles || []), ...(ex.secondaryMuscles || [])].join(' '));

      let score = 0;

      // Coincidencia exacta o muy fuerte en título
      if (nameEn === q || nameEs === q) score += 120;
      if (nameEn.startsWith(q) || nameEs.startsWith(q)) score += 80;
      if (nameEn.includes(q)) score += 60;
      if (nameEs.includes(q)) score += 65;
      if (pron.includes(q)) score += 45;
      if (cats.includes(q)) score += 35;
      if (eqs.includes(q)) score += 35;
      if (muscles.includes(q)) score += 35;
      if (meaning.includes(q) || tech.includes(q)) score += 20;

      // Expansión de sinónimos
      const expandedTerms = new Set([q, ...tokens]);
      for (const [synKey, targets] of Object.entries(SYNONYM_MAP)) {
        if (q.includes(synKey) || tokens.includes(synKey)) {
          targets.forEach(t => expandedTerms.add(normalizeText(t)));
        }
      }

      for (const term of expandedTerms) {
        if (!term) continue;
        if (nameEs.includes(term)) score += 40;
        if (nameEn.includes(term)) score += 35;
        if (muscles.includes(term)) score += 20;
        if (eqs.includes(term)) score += 20;
        if (cats.includes(term)) score += 18;
      }

      // Tolerancia a errores tipográficos por palabra
      const candidateWords = [
        ...nameEn.split(' '),
        ...nameEs.split(' '),
        ...pron.split(' '),
        ...muscles.split(/[\s/]+/)
      ].filter(w => w.length >= 3);

      for (const tok of tokens) {
        if (tok.length < 3) continue;
        for (const cand of candidateWords) {
          const dist = levenshtein(tok, cand);
          const maxAllowed = tok.length <= 5 ? 1 : 2;
          if (dist > 0 && dist <= maxAllowed) {
            score += 18 - dist * 4;
          }
        }
      }

      return score;
    }

    function searchExercises(rawQuery) {
      const q = (rawQuery || '').trim();
      if (!q) return [...appState.exercises];
      return appState.exercises
        .map(ex => ({ ex, score: scoreExerciseMatch(ex, q) }))
        .filter(item => item.score > 0)
        .sort((a, b) => b.score - a.score)
        .map(item => item.ex);
    }

    function searchTerms(rawQuery) {
      const q = normalizeText(rawQuery);
      if (!q) return [...appState.terms];
      return appState.terms
        .map(t => {
          const hay = normalizeText(`${t.term} ${t.fullName} ${t.pronunciation} ${t.translationAr} ${t.explanation}`);
          let score = 0;
          if (normalizeText(t.term) === q) score += 100;
          if (normalizeText(t.term).includes(q)) score += 60;
          if (normalizeText(t.translationAr).includes(q)) score += 50;
          if (hay.includes(q)) score += 25;
          const dist = levenshtein(q, normalizeText(t.term));
          if (q.length >= 3 && dist <= 2) score += 20;
          return { t, score };
        })
        .filter(x => x.score > 0)
        .sort((a, b) => b.score - a.score)
        .map(x => x.t);
    }

    function getSuggestions(rawQuery) {
      const q = normalizeText(rawQuery);
      if (!q || q.length < 2) return [];
      const candidates = [
        ...appState.exercises.map(e => ({ label: e.nameEn, sub: e.nameEsAr, type: 'exercise', id: e.id })),
        ...appState.exercises.map(e => ({ label: e.nameEsAr, sub: e.nameEn, type: 'exercise', id: e.id })),
        ...appState.terms.map(t => ({ label: t.term, sub: t.translationAr, type: 'term', id: t.id }))
      ];

      return candidates
        .map(c => {
          const nLabel = normalizeText(c.label);
          const dist = levenshtein(q, nLabel.slice(0, Math.max(q.length, 3)));
          const includesPartial = nLabel.includes(q) || normalizeText(c.sub).includes(q);
          let rank = 999;
          if (includesPartial) rank = 2;
          else if (dist <= 3) rank = 3 + dist;
          return { ...c, rank };
        })
        .filter(c => c.rank <= 6)
        .sort((a, b) => a.rank - b.rank)
        .slice(0, 5);
    }

